{
  "name": "ani-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:admin",
    "start:admin": "ng serve ani-admin --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "start:login": "ng serve ani-login --host 127.0.0.1 --port 4201 --proxy-config proxy.conf.json",
    "build": "npm run build:admin && npm run build:login",
    "build:admin": "ng build ani-admin",
    "build:login": "ng build ani-login",
    "watch": "ng build ani-admin --watch --configuration development",
    "test": "ng test ani-admin && ng test ani-login",
    "local:core": "npm --prefix bff/mock-ani-core run dev",
    "local:idp": "npm --prefix bff/mock-identity-provider run dev",
    "local:bff": "npm --prefix bff/ani-admin run dev:mock",
    "bff:api": "npm --prefix bff/ani-admin run dev"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
