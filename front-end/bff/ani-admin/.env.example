# Origem do Core; confirmar ambiente antes de conectar. Sem path/credenciais.
ANI_CORE_BASE_URL=https://api.example.invalid
ANI_BFF_PORT=3333
ANI_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://127.0.0.1:4201,http://localhost:4200,http://localhost:4201
ANI_LOGIN_FRONTEND_URL=http://127.0.0.1:4201/
ANI_ADMIN_FRONTEND_URL=http://127.0.0.1:4200/
# Habilitar somente para ambiente autorizado com dados sintéticos.
ANI_BFF_ENABLE_WRITES=false
# Public account creation is separate from administrative writes; enable only in an authorized test environment.
ANI_BFF_ENABLE_PUBLIC_REGISTRATION=false
# Contrato informado de token Bearer + expiresInSeconds + usuario; disabled desativa o login.
ANI_LOGIN_CONTRACT=core-bearer-v1
